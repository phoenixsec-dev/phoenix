{
  "server": {
    "listen": "127.0.0.1:9090"
  },
  "https_listener": {
    "enabled": false,
    "listen": "127.0.0.1:9443",
    "cert": "/data/phoenix/server.crt",
    "key": "/data/phoenix/server.key",
    "ca_cert": "/data/phoenix/ca.crt",
    "ca_key": "/data/phoenix/ca.key"
  },
  "store": {
    "backend": "file",
    "path": "/data/phoenix/store.json",
    "master_key": "/data/phoenix/master.key"
  },
  "crypto": {
    "provider": "file"
  },
  "auth": {
    "bearer": {
      "enabled": true
    }
  },
  "acl": {
    "path": "/data/phoenix/acl.json"
  },
  "audit": {
    "path": "/data/phoenix/audit.log",
    "rotate_mb": 50
  },
  "policy": {
    "path": "/data/phoenix/policy.json"
  },
  "session": {
    "enabled": false,
    "ttl": "1h",
    "roles": {
      "dev": {
        "namespaces": [
          "dev/*",
          "staging/*"
        ],
        "actions": [
          "list",
          "read_value"
        ],
        "bootstrap_trust": [
          "bearer"
        ]
      },
      "deploy": {
        "namespaces": [
          "prod/*"
        ],
        "actions": [
          "list",
          "read_value"
        ],
        "bootstrap_trust": [
          "bearer"
        ],
        "require_seal_key": true
      }
    }
  },
  "dashboard": {
    "enabled": false,
    "password_hash": "",
    "session_ttl": "4h"
  },
  "access_requests": {
    "enabled": true,
    "request_ttl": "15m",
    "default_grant_ttl": "1h",
    "max_grant_ttl": "8h",
    "grantable_actions": [
      "read_value"
    ],
    "require_sealed": true,
    "bind_source_ip": true,
    "approvers": [],
    "deny_paths": []
  },
  "onepassword": {
    "vault": "Engineering",
    "service_account_token_env": "OP_SERVICE_ACCOUNT_TOKEN",
    "cache_ttl": "60s"
  }
}
