{
  "server": {
    "listen": "127.0.0.1:9090"
  },
  "tls": {
    "enabled": false
  },
  "https_listener": {
    "enabled": false,
    "listen": "127.0.0.1:9443",
    "cert": "/data/server.crt",
    "key": "/data/server.key"
  },
  "store": {
    "backend": "file",
    "path": "/data/phoenix/store.json",
    "master_key": "/data/phoenix/master.key"
  },
  "crypto": {
    "provider": "file"
  },
  "auth": {
    "bearer": {
      "enabled": true
    },
    "mtls": {
      "enabled": false,
      "require": false
    }
  },
  "acl": {
    "path": "/data/phoenix/acl.json"
  },
  "audit": {
    "path": "/data/phoenix/audit.log",
    "rotate_mb": 50
  },
  "policy": {
    "path": "/data/phoenix/policy.json"
  },
  "attestation": {
    "nonce": {
      "enabled": false,
      "max_age": "30s"
    },
    "token": {
      "enabled": false,
      "ttl": "15m"
    },
    "local_agent": {
      "enabled": false,
      "socket_path": "/tmp/phoenix-agent.sock"
    }
  },
  "session": {
    "enabled": false,
    "ttl": "1h",
    "roles": {
      "dev": {
        "namespaces": [
          "dev/*",
          "staging/*"
        ],
        "actions": [
          "list",
          "read_value"
        ],
        "bootstrap_trust": [
          "bearer"
        ]
      },
      "deploy": {
        "namespaces": [
          "prod/*"
        ],
        "actions": [
          "list",
          "read_value"
        ],
        "bootstrap_trust": [
          "mtls"
        ],
        "require_seal_key": true,
        "step_up": true,
        "step_up_ttl": "15m",
        "elevates_acl": true,
        "allowed_agents": [
          "deployer"
        ]
      }
    }
  },
  "dashboard": {
    "enabled": false,
    "password_hash": "",
    "session_ttl": "4h"
  },
  "access_requests": {
    "enabled": true,
    "request_ttl": "15m",
    "default_grant_ttl": "1h",
    "max_grant_ttl": "8h",
    "grantable_actions": [
      "read_value"
    ],
    "require_sealed": true,
    "bind_source_ip": true,
    "approvers": [],
    "deny_paths": []
  },
  "onepassword": {
    "vault": "Engineering",
    "service_account_token_env": "OP_SERVICE_ACCOUNT_TOKEN",
    "cache_ttl": "60s"
  }
}
